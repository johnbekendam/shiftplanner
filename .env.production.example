# ShiftPlanner production environment.
#
APP_NAME=ShiftPlanner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://shiftplanner.prodrive.nl
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Release version to run, without the v (tag v1.0.0 gives 1.0.0).
IMAGE_TAG=1.2.0

# docker-compose.yml sets DB_CONNECTION, DB_HOST, and DB_PORT. It also
# passes these three through to the postgres service, so keep them in sync.
DB_DATABASE=shiftplanner
DB_USERNAME=shiftplanner
DB_PASSWORD=klj13489sfp;1320

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Mail: the log driver writes messages to the container log. For
# Microsoft Graph shared-mailbox send, set MAIL_MAILER=graph and fill in
# the GRAPH_* values (app permission Mail.Send on the mailbox).
MAIL_MAILER=graph
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shiftplanner@prodrive-technologies.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microsoft Graph shared-mailbox send. Set MAIL_MAILER=graph to use it.
# GRAPH_MAIL_FROM is the shared mailbox address (app permission Mail.Send).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM=shiftplanner@prodrive-technologies.com

# Seed user, upserted by `php artisan db:seed`. Leave blank to skip seeding.
SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@shiftplanner.nl
SEED_USER_PASSWORD=password
AUTH_AUTO_LOGIN=false
