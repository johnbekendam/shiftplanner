# ShiftPlanner production environment.
#
# scripts/build-image.sh stages this file into dist/ as .env.example and,
# on first run, copies it to dist/.env. Fill in the blank values on the
# server before the first deploy.

APP_NAME=ShiftPlanner
APP_ENV=production
APP_DEBUG=false

# Generate on a machine with the release image:
#   docker run --rm shiftplanner:<version> php artisan key:generate --show
APP_KEY=

# Public address of the app, including the published port.
APP_URL=http://server-name:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Must match the release image tag loaded on the server.
IMAGE_TAG=

# docker-compose.yml sets DB_CONNECTION, DB_HOST, and DB_PORT. It also
# passes these three through to the postgres service, so keep them in sync.
DB_DATABASE=shiftplanner
DB_USERNAME=shiftplanner
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Mail: the log driver writes messages to the container log. For
# Microsoft Graph shared-mailbox send, set MAIL_MAILER=graph and fill in
# the GRAPH_* values (app permission Mail.Send on the mailbox).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="shiftplanner@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_FROM=
